#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int *r = new int[n];

    for (int i = 0; i < n; i++)
        cin >> r[i];

    for (int i = 0; i < n; i++)
        if (*(r + i) == 0)
            *(r + i) = 1;

    for (int i = 0; i < n; i++)
        cout << r[i] << " ";

    delete[] r;
    return 0;
}
